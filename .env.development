# Where `npm run dev` loads the sample volumes from. Exactly one line below
# should be active — comment one out and uncomment the other to switch.

# (1) From the Supabase Storage bucket, same source as production (default):
VITE_DATA_BASE=https://rlrsxbvuapchyyctmtoc.supabase.co/storage/v1/object/public/mri-ct-datasets

# (2) From local disk (public/) — handy offline; comment (1) and uncomment this:
# VITE_DATA_BASE=
