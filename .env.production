# Datasets are served from a public Supabase Storage bucket in production so the
# deploy itself stays tiny. Local dev (npm run dev) leaves this unset and loads
# the volumes from /public instead. The URL is public — no secrets here.
VITE_DATA_BASE=https://rlrsxbvuapchyyctmtoc.supabase.co/storage/v1/object/public/mri-ct-datasets
